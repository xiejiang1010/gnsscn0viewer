<?xml version="1.0" encoding="utf-8"?>
<!-- 信号组卡片下半部分（窗口数值），底部圆角，顶部无描边以与标题无缝衔接 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="14dp" android:bottomRightRadius="14dp" />
            <solid android:color="@color/ui_divider" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="13dp" android:bottomRightRadius="13dp" />
            <solid android:color="@color/ui_surface" />
        </shape>
    </item>
</layer-list>
