<?xml version="1.0" encoding="utf-8"?>
<!-- 信号组卡片上半部分（标题），与 bg_values_card 拼成一张完整卡片 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
            <solid android:color="@color/ui_divider" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="13dp" android:topRightRadius="13dp" />
            <solid android:color="@color/ui_surface" />
        </shape>
    </item>
    <!-- 左侧强调条 -->
    <item android:left="1dp" android:top="12dp" android:bottom="10dp" android:width="3dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="2dp" android:bottomRightRadius="2dp" />
            <solid android:color="@color/ui_accent" />
        </shape>
    </item>
</layer-list>
